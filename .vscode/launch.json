{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Current Project",
            "type": "cppdbg",
            "request": "launch",
            // Путь к exe: текущая папка/build/имя_папки
            "program": "${fileDirname}/build/mybash",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}", 
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // Важно: эта задача должна быть в tasks.json
            "preLaunchTask": "CMake Build Current",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}